FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends qpdf=11.3.0-1+deb12u1 poppler-utils=22.12.0-2+deb12u3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm cache clean --force
COPY src/modules/academico/consents/ ./src/modules/academico/consents/
USER node
CMD ["node", "--import", "tsx", "src/modules/academico/consents/validator-server.ts"]
