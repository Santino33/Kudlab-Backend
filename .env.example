# Copiar a .env local (ignorado), o inyectar desde el gestor de secretos.
DATABASE_URL=
# Recomendado en despliegue: usuario dueño del esquema para migrar, separado del usuario de aplicación.
# MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SPA_ORIGIN=
INVITATION_BASE_URL=
EMAIL_CHANGE_BASE_URL=
RESET_BASE_URL=
# Las tres URLs van al origen SPA, sin query/fragmento/credenciales.
# INVITATION_BASE_URL y EMAIL_CHANGE_BASE_URL deben ser pantallas diferentes.
# Gmail elegido: habilitar verificación en dos pasos y contraseña de aplicación si la cuenta lo permite.
# MAIL_USER y MAIL_FROM: dirección completa de esa cuenta; MAIL_PASSWORD: contraseña de aplicación,
# nunca la contraseña habitual ni un secreto real en Git o el chat.
MAIL_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Puerto 465: TLS implícito. Puerto 587 u otro: STARTTLS obligatorio.
# Host DNS que coincida con el certificado. No se admite desactivar TLS/verificación.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Solo con NODE_ENV=test: MAIL_MODE=capture (sin entregas externas). Nunca usar en despliegue.
# Política: correo .edu.co, contraseña >=8 con mayúscula/minúscula/número,
# invitación válida exactamente 7 días. Las credenciales reales van fuera del repositorio.
