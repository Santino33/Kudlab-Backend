# Copiar a .env local (ignorado), o inyectar desde el gestor de secretos.
DATABASE_URL=
# Recomendado en despliegue: usuario dueño del esquema para migrar, separado del usuario de aplicación.
# MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SPA_ORIGIN=
INVITATION_BASE_URL=
RESET_BASE_URL=
# Pendiente para entrega real: definir cuenta remitente y credenciales SMTP con el operador.
# MAIL_FROM es la dirección de esa cuenta; nunca guardar MAIL_PASSWORD real en Git.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Solo en pruebas locales: MAIL_MODE=capture. Nunca usar en despliegue.
# Política: correo .edu.co, contraseña >=8 con mayúscula/minúscula/número,
# invitación válida exactamente 7 días. Las credenciales reales van fuera del repositorio.
